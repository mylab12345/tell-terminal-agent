# Copy this file to .env and fill in your values.
#
# The agent supports several FREE OpenAI-compatible providers. Pick one,
# set AI_PROVIDER to it, and add the matching API key.  All of these
# have free tiers you can sign up for with just an email.
#
# ┌─────────────┬──────────────────────────────────────────────┬─────────────────────────────────────────────┐
# │ AI_PROVIDER │ Where to get a free API key                  │ Default model                               │
# ├─────────────┼──────────────────────────────────────────────┼─────────────────────────────────────────────┤
# │ groq        │ https://console.groq.com/keys                │ llama-3.3-70b-versatile                     │
# │ gemini      │ https://aistudio.google.com/apikey           │ gemini-2.0-flash                            │
# │ openrouter  │ https://openrouter.ai/keys                   │ meta-llama/llama-3.3-70b-instruct:free      │
# │ cerebras    │ https://cloud.cerebras.ai                    │ llama-3.1-8b-instant                        │
# │ sambanova   │ https://cloud.sambanova.ai                   │ Meta-Llama-3.1-70B-Instruct                 │
# │ openai      │ https://platform.openai.com/api-keys (paid)  │ gpt-4o-mini                                 │
# └─────────────┴──────────────────────────────────────────────┴─────────────────────────────────────────────┘

# ---- Choose your provider (default: groq) ----
AI_PROVIDER=groq

# ---- API keys: set the one for your chosen provider ----
# Groq (recommended, fast + free): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (free models available): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras (free, very fast): https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# SambaNova (free): https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Optional overrides ----

# Model to use (defaults to the provider's preset above).
# AI_MODEL=llama-3.3-70b-versatile

# Override the OpenAI-compatible base URL (usually not needed; the
# provider preset handles it automatically).
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Temperature (0.0 - 1.0). Lower = more deterministic.
# AI_TEMPERATURE=0.2

# Maximum number of auto-approved (non-dangerous) commands per turn.
# Set to 0 to require confirmation before every command.
# MAX_AUTO_STEPS=5

# Command execution timeout in seconds.
# COMMAND_TIMEOUT=120
